<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Must match the Kotlin library's android.namespace (platform/android/app) so unqualified
         Activity name references (".MainActivity", ".GameActivity") in its manifest resolve
         consistently once merged into this app, and so ${applicationId}.fileprovider etc. in that
         manifest line up with this app's real package. -->
    <ApplicationId>org.sharpemu.android</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.0.2_poc</ApplicationDisplayVersion>
    <!-- The whole SharpEmu.Android/ProjectReference chain (Core/HLE/Libs/...) is not written with
         trimming/AOT safety in mind (reflection-based JSON, dynamic P/Invoke resolution in a few
         HLE export tables) — leave trimming and AOT off until that's been audited, rather than risk
         silent runtime breakage for an app-size/startup-time win. This also keeps the interpreter
         itself running under plain Mono JIT rather than Mono's Full/Hybrid AOT — compiling it
         AOT-only would remove the JIT's own ability to specialize hot interpreter loops at runtime,
         on top of being an unaudited-safety risk for the same reflection-heavy code. Release mode
         defaults RunAOTCompilation=true, which requires PublishTrimmed=true (XA1030) — both are
         disabled together here for that reason. -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <!-- Marshal Methods (default on for Release) generates native-to-managed JNI trampolines
         ("n_Xxx_mm_wrapper") ahead of time instead of registering methods dynamically. Confirmed by
         two separate on-device failures: (1) UnsatisfiedLinkError for a completely unrelated class's
         n_onCreate right after incremental (non-clean) rebuilds — a marshal-methods codegen staleness
         bug; (2) SDLActivity.n_Main_mm_wrapper's exception marshaling itself threw
         MethodAccessException on AndroidEnvironmentInternal.UnhandledException when Main() faulted,
         masking the real exception. Disabling it falls back to normal JNI RegisterNatives, which
         doesn't have either problem. -->
    <AndroidEnableMarshalMethods>false</AndroidEnableMarshalMethods>
    <!-- A Debug APK must be self-contained ("distributable debug"). Debug defaults
         EmbedAssembliesIntoApk=false (Fast Deployment), which EXCLUDES the .NET assemblies
         from the APK and expects them adb-pushed into files/.__override__/<abi> — an APK
         built that way aborts at startup with "No assemblies found in
         '.../__override__/arm64-v8a' ... Assuming this is part of Fast Deployment. Exiting..."
         (monodroid-glue.cc create_domain) whenever it is installed outside an `adb deploy`,
         e.g. the debug APK published by .github/workflows/build.yml and sideloaded from the
         browser. Embedding the assemblies keeps the build otherwise Debug-shaped (debuggable,
         debug-keystore signed, untrimmed, no AOT); it only loses the adb fast-deploy loop —
         local on-device iteration reinstalls via `adb install -r` instead. -->
    <EmbedAssembliesIntoApk Condition="'$(Configuration)' == 'Debug'">true</EmbedAssembliesIntoApk>
  </PropertyGroup>

  <ItemGroup>
    <!-- Plain net10.0 class libraries, referenced directly — no interop layer needed here, this is
         ordinary managed code calling managed code (the one part of this port needing no
         Android-specific adaptation at all — see Fase 1's OperatingSystem.IsAndroid() guards inside
         these projects for the platform-specific edges they do have). -->
    <ProjectReference Include="..\SharpEmu.Core\SharpEmu.Core.csproj" />
    <ProjectReference Include="..\SharpEmu.HLE\SharpEmu.HLE.csproj" />
    <ProjectReference Include="..\SharpEmu.Libs\SharpEmu.Libs.csproj" />
    <ProjectReference Include="..\SharpEmu.Logging\SharpEmu.Logging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Kotlin/Compose UI (game library, settings, controller config, touch overlay — see
         platform/android/app) built as an Android library .aar. Java.Interop generates C#-callable
         bindings for its public types, including the EmulatorBridge interface this project
         implements (EmulatorBridgeImpl.cs) and hands to the library via EmulatorBridgeHolder. -->
    <AndroidLibrary Include="..\..\platform\android\app\build\outputs\aar\app-release.aar" />
  </ItemGroup>

  <ItemGroup>
    <!-- AndroidLibrary (above) embeds the .aar's own classes/resources, but — unlike a real Gradle
         module reference — does NOT resolve its Maven dependency graph (androidx.core, Compose,
         etc.), since a raw local .aar file carries no POM for that. platform/android/app's
         build.gradle.kts declares these as plain Gradle `implementation(...)` deps, which Gradle
         itself resolves transitively when building the .aar standalone — but the merged app built
         here needs them added again, explicitly, as real Xamarin.AndroidX NuGet packages (which
         carry their own correct NuGet-level transitive dependency graph, unlike AndroidMavenLibrary,
         which is just a Maven-file downloader with the exact same "no transitive resolution"
         limitation as a raw local AndroidLibrary reference).
         Discovered by a real crash on device: ClassNotFoundException on androidx.core.content.
         FileProvider (declared in the merged manifest, used by the log-export feature) — Core is
         the confirmed-necessary one; the rest mirror the Gradle dependencies block 1:1 pre-emptively. -->
    <PackageReference Include="Xamarin.AndroidX.Core" />
    <PackageReference Include="Xamarin.AndroidX.Activity.Compose" />
    <PackageReference Include="Xamarin.AndroidX.DocumentFile" />
    <PackageReference Include="Xamarin.AndroidX.Startup.StartupRuntime" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Foundation" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material.Icons.Core" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material.Icons.Extended" />
    <PackageReference Include="Xamarin.AndroidX.Compose.Material3" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI" />
    <PackageReference Include="Xamarin.AndroidX.Compose.UI.Tooling.Preview" />
  </ItemGroup>
</Project>
